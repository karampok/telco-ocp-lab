; sno.telco.vlab zone file

$ORIGIN sno.telco.vlab.
$TTL 3600

@   IN  SOA ns1.sno.telco.vlab. hostmaster.sno.telco.vlab. (
           2026061801 ; Serial
           3600       ; Refresh
           900        ; Retry
           604800     ; Expire
           86400 )    ; Minimum TTL

@   IN  NS  ns1.sno.telco.vlab.

api    IN  A     10.10.30.225
api    IN  AAAA  2600:10:10:30::225
*.apps IN  A     10.10.30.225
*.apps IN  AAAA  2600:10:10:30::225
