table inet clab
delete table inet clab
table inet clab {
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    udp dport 51820 iifname != "vlab-upstream" dnat ip to 10.10.20.200
    tcp dport 32472 ip daddr 10.6.105.20 dnat ip to 10.10.30.225:32472
    tcp dport 6183 ip daddr 10.6.105.20 dnat ip to 10.10.30.225:6183
  }
  chain postrouting {
    type nat hook postrouting priority srcnat - 1; policy accept;
    ip saddr 10.10.0.0/16 oifname != "vlab-upstream" masquerade;
    ip daddr 10.10.30.225 tcp dport 32472 snat to 10.6.105.20
  }
}
